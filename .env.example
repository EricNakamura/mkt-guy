# OpenRouter (podes reutilizar a chave do mm-orcamentos/api/.env)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_ASR_MODEL=openai/whisper-large-v3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Site
SITE_URL=https://www.memremodelacoes.pt
# Caminho do repositório do site (local ou dentro do container; vê o README)
SITE_REPO=/caminho/para/mm-remodelacoes
WHATSAPP=351933873125

# Preview local (o Docker força HOST=0.0.0.0 e PREVIEW_PORT=4321)
PREVIEW_PORT=4321
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4321

# Painel — utilizador:password (obrigatório quando HOST=0.0.0.0)
DASHBOARD_AUTH=mm:troca-esta-password

# Telegram (opcional; cria um bot com @BotFather)
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
